#.env.dev 
# Path: .env local - to example
# mongo Atlas db
API_POKEMON_URL=https://pokeapi.co/api/v2
NODE_ENV=dev
DB_MONGODB_URI=
DB_MONGODB_NAME=pokemonDB
DEFAULT_LIMIT=10
PORT=3000


#.env.prod 
# Path: .env.prod local - to example
API_POKEMON_URL=https://pokeapi.co/api/v2
NODE_ENV=prod
DB_MONGODB_URI=mongodb://mongo-poke:27017/nest-pokemon
DEFAULT_LIMIT=10
PORT=3000
